{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(xcrun simctl erase*)",
      "Bash(xcrun simctl delete*)",
      "Bash(xcrun simctl shutdown all*)",
      "Bash(adb emu kill*)",
      "Bash(adb uninstall*)",
      "Bash(avdmanager delete avd*)",
      "Bash(appium driver uninstall*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git push|git commit|git merge)",
        "hooks": [
          {
            "type": "command",
            "command": "REMOTE=$(git config --get remote.origin.url 2>/dev/null || echo ''); if [[ \"$REMOTE\" == *\"logistics-shipmondo-mobile-testing\"* ]]; then echo 'Repo validation passed'; exit 0; fi; echo 'BLOCKED: this repository may only write to logistics-shipmondo-mobile-testing, got: '$REMOTE; exit 1",
            "statusMessage": "Validating repository access..."
          }
        ]
      }
    ]
  }
}
