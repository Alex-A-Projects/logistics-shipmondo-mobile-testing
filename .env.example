# =============================================================================
# Shipmondo mobile-web test framework — environment variables
#
# Copy to `.env` and fill in. NEVER commit a filled-in `.env`.
# Every value below has a safe default in `src/shared/env.ts`; only the
# credentials are mandatory.
# =============================================================================

# ── UI environment selector ─────────────────────────────────────────────────
# Which Shipmondo tenant the mobile browsers are pointed at:
#   demo | staging | release
# This axis drives navigation only.
TEST_ENV=demo

# ── Base URLs per environment ───────────────────────────────────────────────
DEMO_BASE_URL=https://demo.shipmondo.com
STAGING_BASE_URL=
RELEASE_BASE_URL=

# ── Web app login (UI suite) ────────────────────────────────────────────────
# Credentials for the Shipmondo web app itself.
# The demo login page accepts an `email` query parameter that pre-fills the
# address field, e.g.
#   https://demo.shipmondo.com/account/login?locale=en&email=<address>
SHIPMONDO_WEB_USER=
SHIPMONDO_WEB_PASSWORD=

# Path of the login page, relative to the base URL.
SHIPMONDO_LOGIN_PATH=/account/login?locale=en

# ── Appium server connection ────────────────────────────────────────────────
# When `WDIO_APPIUM_SERVICE=true` (the default) WebdriverIO starts its own
# Appium 2 server; set it to `false` to use an Appium instance you started
# yourself.
WDIO_APPIUM_SERVICE=true
APPIUM_HOST=localhost
APPIUM_PORT=4723
# Extra arguments passed to the managed Appium server, e.g.
# APPIUM_ARGS=--log-level=debug --relaxed-security
APPIUM_ARGS=

# ── iOS Simulator (XCUITest / Safari) ───────────────────────────────────────
# The suite targets the iPhone 17 family. Override to run on another
# simulator that is already booted.
IOS_DEVICE=iPhone 17 Pro
IOS_VERSION=26.0
# Set IOS_UDID when more than one simulator is booted, e.g.
# IOS_UDID=00000000-0000000000000000
IOS_UDID=

# ── Android Emulator (UiAutomator2 / Chrome) ────────────────────────────────
# The suite targets the latest Samsung Galaxy emulator image.
ANDROID_DEVICE=Samsung Galaxy S25
ANDROID_OS=15
# Set ANDROID_UDID when more than one emulator is running, e.g.
# ANDROID_UDID=emulator-5554
ANDROID_UDID=

# ── Ticket prefix for test titles ───────────────────────────────────────────
# Test titles are formatted `PREFIX-1234 | what is verified`.
TICKET_PREFIX=SHIP

# ── Timeouts (milliseconds) ─────────────────────────────────────────────────
# Mobile browsers are slower than desktop ones: every wait in the suite is
# expressed as a state wait, never as a fixed sleep.
WAIT_FOR_DISPLAYED=20000
WAIT_FOR_PAGE_LOAD=60000
WAIT_FOR_SCRIPT=20000

# ── Reporting ───────────────────────────────────────────────────────────────
# Title shown on the Allure report and in the console banner.
REPORT_TITLE=Shipmondo Mobile-Web Test Report
