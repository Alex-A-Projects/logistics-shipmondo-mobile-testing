{
  "name": "logistics-shipmondo-mobile-testing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-web UI test framework for the Shipmondo demo platform — Safari on an iPhone 17 Simulator (XCUITest) and Chrome on a Samsung Galaxy Emulator (UiAutomator2) via WebdriverIO + Appium 2.",
  "scripts": {
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:android": "wdio run wdio.android.conf.ts",
    "test:both": "npm run test:android && npm run test:ios",
    "test:smoke:ios": "wdio run wdio.ios.conf.ts --mochaOpts.grep @smoke",
    "test:smoke:android": "wdio run wdio.android.conf.ts --mochaOpts.grep @smoke",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "appium-2",
    "typescript",
    "mobile-web",
    "ios",
    "android",
    "xcuitest",
    "uiautomator2",
    "safari",
    "chrome",
    "shipmondo",
    "logistics",
    "page-object-model",
    "mocha",
    "allure"
  ],
  "author": "QA Engineer",
  "license": "MIT",
  "dependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "allure-commandline": "^2.27.0",
    "appium": "^2.19.0",
    "dotenv": "^16.4.5",
    "expect-webdriverio": "^6.0.9",
    "webdriverio": "^9.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
